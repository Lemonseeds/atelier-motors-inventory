{
  "name": "atelier-motors-inventory",
  "private": true,
  "type": "module",
  "author": "Codex <codex@openai.com>",
  "contributors": [
    "Lemonseeds <ayrtonjoep@gmail.com>",
    "Gemini <200291788+gemini-code-assist@users.noreply.github.com>",
    "Google Antigravity <antigravity-ai@google.com>"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:client\"",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "npm run test:server && npm run test:client",
    "test:server": "node --test \"server/**/*.test.js\"",
    "test:client": "vitest run",
    "coverage:server": "node --test --experimental-test-coverage \"server/**/*.test.js\"",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.4.1",
    "express": "^5.1.0",
    "lenis": "^1.3.27",
    "lucide-react": "^0.546.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.14",
    "three": "^0.186.1",
    "vite": "^7.1.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "concurrently": "^9.2.1",
    "jsdom": "^29.1.1",
    "supertest": "^7.1.4",
    "vitest": "^3.2.7"
  }
}
