# Generate a unique random value of at least 32 characters for production.
JWT_SECRET=replace-with-a-long-random-secret
# A user registering with this email becomes the first admin.
ADMIN_EMAIL=admin@example.com
PORT=3001
# Optional. Defaults to ./data/inventory.db
DATABASE_PATH=./data/inventory.db

# Optional Groq Cloud LLM for AI Concierge recommendations (e.g. gsk_...)
# Get a free API key at https://console.groq.com/keys
# If not set, the assistant gracefully falls back to the smart local recommendation engine.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
